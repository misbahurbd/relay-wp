{
  "components": {
    "schemas": {
      "Detail": {
        "additionalProperties": false,
        "properties": {
          "field": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "type": "object"
      },
      "ErrorBody": {
        "additionalProperties": false,
        "properties": {
          "code": {
            "description": "Machine-readable error code",
            "examples": [
              "not_found"
            ],
            "type": "string"
          },
          "details": {
            "description": "Per-field problems, if any",
            "items": {
              "$ref": "#/components/schemas/Detail"
            },
            "type": [
              "array",
              "null"
            ]
          },
          "message": {
            "description": "Human-readable message",
            "examples": [
              "Resource not found"
            ],
            "type": "string"
          }
        },
        "required": [
          "code",
          "message"
        ],
        "type": "object"
      },
      "StatusOutputBody": {
        "additionalProperties": false,
        "properties": {
          "status": {
            "examples": [
              "ok"
            ],
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Relay API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/healthz": {
      "get": {
        "description": "Returns ok while the process is running. Does not check dependencies.",
        "operationId": "health",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "default": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Error"
          }
        },
        "summary": "Liveness check",
        "tags": [
          "system"
        ]
      }
    },
    "/readyz": {
      "get": {
        "description": "Returns ok when the database answers; 503 otherwise.",
        "operationId": "ready",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StatusOutputBody"
                }
              }
            },
            "description": "OK"
          },
          "500": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Internal Server Error"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorBody"
                }
              }
            },
            "description": "Service Unavailable"
          }
        },
        "summary": "Readiness check",
        "tags": [
          "system"
        ]
      }
    }
  }
}
