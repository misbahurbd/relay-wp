# Copy to .env and adjust. Each app reads the variables it needs.

# --- Local services (host ports for deploy/docker-compose.yml) ---
POSTGRES_PORT=5432
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
S3_PORT=9000
S3_CONSOLE_PORT=9001

# --- API ---
APP_ENV=development
HTTP_ADDR=:8080
LOG_LEVEL=debug
LOG_FORMAT=text

# Pooled connection for queries; direct connection for River (LISTEN/NOTIFY) and migrations.
DATABASE_URL=postgres://relay:relay@localhost:5432/relay?sslmode=disable
DATABASE_DIRECT_URL=postgres://relay:relay@localhost:5432/relay?sslmode=disable
DATABASE_MAX_CONNS=10
DATABASE_DIRECT_MAX_CONNS=4

# Browser origins allowed to call the API with cookies (comma-separated).
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Proxy CIDRs whose X-Forwarded-For is trusted (comma-separated). Empty = trust none.
TRUSTED_PROXIES=
RATE_LIMIT_REQUESTS=300
RATE_LIMIT_WINDOW=1m
HTTP_SHUTDOWN_TIMEOUT=10s

QUEUE_MAX_WORKERS=10

# smtp or log
MAILER_DRIVER=smtp
MAILER_FROM=no-reply@relay.test
MAILER_FROM_NAME=Relay
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
# none, starttls or tls
SMTP_TLS=none

# s3 or memory. In development the bucket is created if missing.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=relay
S3_SECRET_KEY=relay-secret
S3_BUCKET=relay
S3_PATH_STYLE=true

# --- Auth ---
# Web app address, used for links in emails.
APP_BASE_URL=http://localhost:3000
# Ed25519 signing key for access tokens. `task setup` fills these in;
# generate another with `task keygen`. Never reuse the local key in production.
JWT_SIGNING_KEY=
JWT_SIGNING_KEY_ID=
# During key rotation: comma-separated kid:base64-public-key pairs still accepted.
JWT_PREVIOUS_PUBLIC_KEYS=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=720h
COOKIE_DOMAIN=
# false only for plain-HTTP local development.
COOKIE_SECURE=false
# Reject passwords found in data breaches (Have I Been Pwned; the password is never sent).
PASSWORD_BREACH_CHECK=true
# How recent a sign-in must be to set a password or connect/disconnect a provider.
REAUTH_MAX_AGE=10m

# --- Social sign-in ---
# Public address of this API; OAuth callbacks are {API_BASE_URL}/v1/auth/oauth/{provider}/callback.
API_BASE_URL=http://localhost:8080
# Extra exact URLs a social sign-in may return to (mobile deep links). Any page of APP_BASE_URL is always allowed.
AUTH_ALLOWED_REDIRECTS=
# A provider with no credentials is simply not offered. Setup: README section 9.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Go runtime: keep below the container memory limit (1 GB).
GOMEMLIMIT=800MiB

# --- Web ---
# Dev server port. Keep CORS_ALLOWED_ORIGINS in sync with it.
WEB_PORT=3000
VITE_API_URL=http://localhost:8080
